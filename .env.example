# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Optional — leave BOTH unset for the safest default:
#   JWT_SECRET: a random secret is auto-generated to $DATA_DIR/jwt-secret (mode 0600)
#   INITIAL_PASSWORD: the ONLY bootstrap dashboard password. There is no built-in
#     default any more: with no password set and no SSO configured the dashboard is
#     reachable from this machine only (remote callers get told to set one), and the
#     first password has to be set locally. Headless installs (Docker / fnOS) should
#     set this so the operator can log in from another device, then change it in the
#     dashboard.
#   CREDENTIAL_SECRET: key material for the credential encryption that protects
#     provider tokens/keys inside the database. Leave it unset and a random key is
#     generated to $DATA_DIR/credential-key (0600). Set it to keep the key out of the
#     data directory entirely (containers, shared volumes). Changing it makes existing
#     stored credentials unreadable — connections then report "Credentials unreadable"
#     and have to be re-authorized, so back it up with the database.
# If you set JWT_SECRET yourself, use a long random value — known placeholder
# strings are rejected at startup.
# JWT_SECRET=
# INITIAL_PASSWORD=
# CREDENTIAL_SECRET=
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
# API_KEY_SECRET: optional. If you set it, use a long random value.
# API_KEY_ROTATION: experimental, default off. Opting in (=true) auto-generates
# a secret to $DATA_DIR/api-key-secret (mode 0600) — existing API keys must be
# re-issued after enabling (CRC secret changes).
# API_KEY_SECRET=
# API_KEY_ROTATION=false
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
# REQUIRE_API_KEY is NOT read by the runtime — the real switch is the
# `requireApiKey` row in the dashboard settings DB (default: true).

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Self-hosted & Docker private network opt-in (Issue #25)
# Allows custom provider nodes / upstream services on internal/private IP ranges or Docker container names.
# Keep disabled (default) when the instance is exposed to untrusted networks.
# ALLOW_PRIVATE_HOSTS=1                                             # Master switch: allow all private/internal hosts
# PRIVATE_HOST_ALLOWLIST=cli-proxy-api-plus,host.docker.internal   # Granular exact-match allowlist

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router
